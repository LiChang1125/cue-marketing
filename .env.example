# Local development retains the existing Chrome connection.
HOST=127.0.0.1
PORT=4173
DATA_DIR=./data
PLATFORM_PROVIDER=browser

# Optional: DOUYIN_PROVIDER=tikhub uses a paid API for Douyin only.
# Leave empty for the existing browser collector. Never put keys in VITE_*.
DOUYIN_PROVIDER=
TIKHUB_API_KEY=
# Set an approved request cap before enabling paid collection (Beijing day).
# Zero disables paid requests; cached content remains available.
PLATFORM_DAILY_REQUEST_LIMIT=0
# Set a long random value for cloud maintenance endpoints.
ADMIN_TOKEN=

# Recommended for self-hosted Docker cloud: no paid API required.
# Compose always uses PLATFORM_PROVIDER=selfhosted.
# VNC is reachable only through an administrator SSH tunnel.
VNC_PASSWORD=
# Tencent Cloud builds can use mirrors.cloud.tencent.com for Debian packages.
# The default remains deb.debian.org; package signatures stay enabled.
DEBIAN_MIRROR=deb.debian.org
# Set false for the cloud desktop; keep true for headless development checks.
CLOUD_BROWSER_HEADLESS=true
