FROM node:24-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package*.json requirements-public.txt ./
RUN npm ci --include=dev && python3 -m venv /opt/cue-python && /opt/cue-python/bin/pip install --no-cache-dir -r requirements-public.txt
ENV PATH="/opt/cue-python/bin:${PATH}" PYTHON=/opt/cue-python/bin/python PYTHONIOENCODING=utf-8
COPY . .
RUN node scripts/setup-trendradar.mjs && npm run build && mkdir -p /var/data/cue /app/.tools/translation /app/.artifacts && chown -R node:node /var/data/cue /app/.tools /app/.artifacts
USER node
ENV HOST=0.0.0.0 PORT=4173 DATA_DIR=/var/data/cue COLLECT_INTERVAL_MS=600000 NODE_ENV=production
EXPOSE 4173
CMD ["node","server/public-server.js"]
