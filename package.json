{
  "name": "zhichao-discovery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "pulse:prepare": "node integrations/aihot/prepare.mjs",
    "pulse:start": "node integrations/aihot/start.mjs",
    "pulse:preview": "node scripts/preview-brand-pulse.mjs",
    "typecheck": "npm --prefix .tools/aihot-upstream run typecheck",
    "hot-monitor:prepare": "node scripts/setup-hot-monitor.mjs",
    "hot-monitor:preview": "node scripts/preview-hot-monitor.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:pulse-search": "node scripts/test-pulse-search.mjs",
    "test:pulse-live": "node scripts/check-pulse-live.mjs",
    "report:daily": "node scripts/generate-report.mjs",
    "sources:install": "node scripts/install-adapters.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "collector:pause": "node --env-file-if-exists=.env scripts/collector-control.mjs pause",
    "collector:resume": "node --env-file-if-exists=.env scripts/collector-control.mjs resume"
  },
  "dependencies": {
    "@jackwener/opencli": "^2.0.3",
    "cheerio": "^1.1.2",
    "express": "^5.1.0",
    "ipaddr.js": "^1.9.1",
    "lucide-react": "^0.468.0",
    "opencc-js": "1.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.56.0",
    "vite": "^7.2.0"
  }
}
